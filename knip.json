{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "test/helpers/fakeMcpServer.mjs",
        "test/helpers/fakeCodexServer.mjs",
        "test/helpers/fakeCopilot.mjs",
        "crates/zvs-host/skills/*/assets/*.js"
      ],
      "ignoreBinaries": ["tauri"],
      "ignore": ["scripts/app-env.d.mts"]
    },
    "apps/studio": {
      "entry": [
        "src/browser-ui/main.tsx",
        "src/computer-ui/main.tsx",
        "src/recovery/main.ts",
        "src-tauri/isolation/index.js",
        "src-tauri/src/browser/gateway/page.js",
        "src-tauri/src/browser/automation/presence.js"
      ],
      "ignoreDependencies": ["@tauri-apps/cli"],
      "ignore": ["src-tauri/src/browser/gateway/page.d.ts"]
    },
    "packages/eslint-config": {
      "ignoreDependencies": ["eslint-import-resolver-typescript"]
    }
  }
}
