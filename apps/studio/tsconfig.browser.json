{
  "extends": "@zvs/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "rootDir": "src",
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/browser-ui/**/*.ts",
    "src/browser-ui/**/*.tsx",
    "src/computer-ui/**/*.ts",
    "src/computer-ui/**/*.tsx",
    "src/renderer/app/palettes.ts",
    "src/renderer/features/chat/goalCopy.ts",
    "src/renderer/features/chat/toolPresentation.ts",
    "src/renderer/features/computer/iconUrl.ts"
  ]
}
