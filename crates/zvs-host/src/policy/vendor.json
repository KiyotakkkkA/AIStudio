{
  "id": "vendor.core",
  "allows": true,
  "rules": [
    {
      "id": "vendor.files.deny-vcs-internals",
      "effect": "deny",
      "text": "Version control internals (.git, .hg, .svn, hooks included) are never deleted, overwritten or replaced by a move.",
      "files": {
        "paths": ["**/.git/**", "**/.hg/**", "**/.svn/**"],
        "operations": ["overwrite", "moveOnto", "delete"]
      }
    },
    {
      "id": "vendor.files.deny-keys-and-credential-stores",
      "effect": "deny",
      "text": "SSH and GPG folders, cloud credential stores and private key files are never deleted, overwritten or replaced by a move.",
      "files": {
        "paths": [
          "**/.ssh/**",
          "**/.gnupg/**",
          "**/.aws/**",
          "**/.azure/**",
          "**/.kube/**",
          "**/.docker/config.json",
          "**/.git-credentials",
          "**/.netrc",
          "**/_netrc",
          "**/id_rsa*",
          "**/id_ed25519*",
          "**/id_ecdsa*",
          "**/*.pem",
          "**/*.key",
          "**/*.pfx",
          "**/*.p12",
          "**/*.kdbx"
        ],
        "operations": ["overwrite", "moveOnto", "delete"]
      }
    },
    {
      "id": "vendor.files.deny-autostart",
      "effect": "deny",
      "text": "Windows autostart folders are never written by an agent: a file there runs at every sign-in.",
      "files": { "paths": ["**/Microsoft/Windows/Start Menu/Programs/Startup/**"] }
    },
    {
      "id": "vendor.files.ask-env-and-secrets",
      "effect": "ask",
      "text": "Environment, secret and package registry files (.env, secrets.*, credentials.*, .npmrc, .pypirc) can hold credentials; changing them needs the user.",
      "files": {
        "paths": [
          "**/.env",
          "**/.env.*",
          "**/secrets.{json,yaml,yml,toml,env}",
          "**/*.secret",
          "**/credentials.{json,xml,yaml,yml}",
          "**/.npmrc",
          "**/.pypirc"
        ],
        "operations": ["overwrite", "moveOnto", "delete"]
      }
    },
    {
      "id": "vendor.files.ask-shell-profiles",
      "effect": "ask",
      "text": "Shell profiles and the global git configuration apply to every new terminal; changing them needs the user.",
      "files": {
        "paths": [
          "**/.bashrc",
          "**/.bash_profile",
          "**/.zshrc",
          "**/.profile",
          "**/*profile.ps1",
          "**/.gitconfig"
        ],
        "operations": ["overwrite", "moveOnto", "delete"]
      }
    },
    {
      "id": "vendor.files.ask-ci-pipelines",
      "effect": "ask",
      "text": "CI pipelines run with repository secrets; changing them needs the user.",
      "files": {
        "paths": [
          "**/.github/workflows/**",
          "**/.gitlab-ci.yml",
          "**/azure-pipelines.yml",
          "**/.circleci/**",
          "**/Jenkinsfile"
        ],
        "operations": ["overwrite", "moveOnto", "delete"]
      }
    },
    {
      "id": "vendor.files.ask-user-documents",
      "effect": "ask",
      "text": "Office documents, PDFs, design files, databases and archives are user data that is not regenerated; deleting or replacing them needs the user.",
      "files": {
        "paths": [
          "**/*.{doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,pdf,psd,ai,sketch,fig}",
          "**/*.{sqlite,sqlite3,db,mdb,accdb}",
          "**/*.{zip,7z,rar,tar,gz}"
        ],
        "operations": ["overwrite", "moveOnto", "delete"]
      }
    },
    {
      "id": "vendor.files.allow-build-output",
      "effect": "allow",
      "text": "Build output and tool caches are regenerated by the build, so they can be deleted or overwritten.",
      "files": {
        "paths": [
          "**/node_modules/**",
          "**/target/**",
          "**/dist/**",
          "**/build/**",
          "**/out/**",
          "**/obj/**",
          "**/.next/**",
          "**/.nuxt/**",
          "**/.turbo/**",
          "**/.cache/**",
          "**/.parcel-cache/**",
          "**/coverage/**",
          "**/__pycache__/**",
          "**/.pytest_cache/**",
          "**/.mypy_cache/**",
          "**/.ruff_cache/**",
          "**/.tox/**",
          "**/*.pyc",
          "**/*.tsbuildinfo"
        ],
        "operations": ["overwrite", "moveOnto", "delete"]
      }
    },
    {
      "id": "vendor.files.allow-logs-and-temp",
      "effect": "allow",
      "text": "Log, temporary and backup files left by tools can be deleted or overwritten.",
      "files": {
        "paths": [
          "**/*.log",
          "**/*.tmp",
          "**/*.temp",
          "**/*.bak",
          "**/*.orig",
          "**/*.rej",
          "**/*~"
        ],
        "operations": ["overwrite", "moveOnto", "delete"]
      }
    },
    {
      "id": "vendor.process.deny-remote-history-rewrite",
      "effect": "deny",
      "text": "git push with --force, -f, --force-with-lease, --mirror, --delete or --prune rewrites or removes remote history and never runs automatically.",
      "process": {
        "argv": [
          "git",
          "push",
          "**",
          "{--force,-f,--force-with-lease*,--force-if-includes,--mirror,--delete,-d,--prune}",
          "**"
        ]
      }
    },
    {
      "id": "vendor.process.deny-system-tools",
      "effect": "deny",
      "text": "Disk, boot, registry, service, scheduler, ownership and shutdown tools never run automatically.",
      "process": {
        "argv": [
          "{format,diskpart,bcdedit,bootrec,reg,regedit,sc,schtasks,takeown,icacls,cacls,cipher,vssadmin,wbadmin,shutdown,logoff,runas,mountvol,fsutil}",
          "**"
        ]
      }
    },
    {
      "id": "vendor.process.deny-repository-deletion",
      "effect": "deny",
      "text": "Deleting a hosted repository never runs automatically.",
      "process": { "argv": ["gh", "repo", "delete", "**"] }
    },
    {
      "id": "vendor.process.ask-system-configuration",
      "effect": "ask",
      "text": "Network, user, environment and system file configuration tools (net, netsh, setx, attrib, wmic, sfc, dism, powercfg, bitsadmin) change the machine; they need the user.",
      "process": { "argv": ["{net,netsh,setx,attrib,wmic,sfc,dism,powercfg,bitsadmin}", "**"] }
    },
    {
      "id": "vendor.process.ask-script-strings",
      "effect": "ask",
      "text": "An interpreter given a script string (cmd /c, powershell -Command, bash -c, python -c, node -e) hides what runs from the rules; it needs the user.",
      "process": {
        "argv": [
          "{cmd,powershell,pwsh,bash,sh,zsh,wsl,python,python3,py,node,deno,bun,ruby,perl}",
          "**",
          "{/c,/k,-c,-command,-encodedcommand,-enc,-e,--eval,-p,--print}",
          "**"
        ]
      }
    },
    {
      "id": "vendor.process.ask-discarding-git-work",
      "effect": "ask",
      "text": "git commands that discard uncommitted work or rewrite local history (reset, clean, checkout, switch, restore, stash, rebase, filter-branch, gc, prune) need the user.",
      "process": {
        "argv": [
          "git",
          "{reset,clean,checkout,switch,restore,stash,rebase,filter-branch,filter-repo,reflog,gc,prune,update-ref,worktree}",
          "**"
        ]
      }
    },
    {
      "id": "vendor.process.ask-git-ref-deletion",
      "effect": "ask",
      "text": "Deleting, renaming or force-moving git branches and tags needs the user.",
      "process": {
        "argv": ["git", "{branch,tag}", "**", "{-d,-D,--delete,-m,-M,--move,-f,--force}", "**"]
      }
    },
    {
      "id": "vendor.process.ask-git-amend",
      "effect": "ask",
      "text": "git commit --amend rewrites the last commit; it needs the user.",
      "process": { "argv": ["git", "commit", "**", "--amend", "**"] }
    },
    {
      "id": "vendor.process.ask-publishing",
      "effect": "ask",
      "text": "Publishing, pushing and releasing reach other people (npm publish, cargo publish, twine upload, docker push, gh release, git push); they need the user.",
      "process": {
        "argv": [
          "{npm,pnpm,yarn,bun,cargo,twine,docker,podman,gh,git,dotnet,nuget,gem,poetry,uv}",
          "**",
          "{publish,upload,push,release,login,yank,owner,unpublish,deprecate}",
          "**"
        ]
      }
    },
    {
      "id": "vendor.process.ask-installs",
      "effect": "ask",
      "text": "Installing or removing packages runs their install scripts and can change the machine (winget, choco, scoop, msiexec, npm/pnpm/yarn install or add, pip install, cargo install); it needs the user.",
      "process": {
        "argv": [
          "{winget,choco,scoop,msiexec,cargo,pip,pip3,pipx,npm,pnpm,yarn,bun,gem,go,dotnet,rustup,uv,poetry}",
          "**",
          "{install,i,ci,uninstall,add,remove,rm,-g,--global,--user,upgrade,update,up,sync}",
          "**"
        ]
      }
    },
    {
      "id": "vendor.process.ask-network-transfer",
      "effect": "ask",
      "text": "Network transfer tools can upload local files or fetch code (curl, wget, scp, sftp, rsync, ssh, ftp, nc, certutil); they need the user.",
      "process": {
        "argv": ["{curl,wget,scp,sftp,rsync,ssh,ftp,tftp,nc,ncat,telnet,certutil}", "**"]
      }
    },
    {
      "id": "vendor.process.ask-process-control",
      "effect": "ask",
      "text": "Stopping other processes can lose unsaved work; it needs the user.",
      "process": { "argv": ["{taskkill,kill,pkill,killall,tskill}", "**"] }
    },
    {
      "id": "vendor.process.ask-delete-commands",
      "effect": "ask",
      "text": "Delete commands (rm, rmdir, del, rimraf, Remove-Item) bypass the file snapshot that fs.apply keeps; they need the user.",
      "process": { "argv": ["{rm,rmdir,rd,del,erase,rimraf,trash,remove-item}", "**"] }
    },
    {
      "id": "vendor.process.allow-git-read",
      "effect": "allow",
      "text": "Read-only git commands (status, diff, log, show, blame, ls-files, rev-parse, describe, grep, shortlog) change nothing.",
      "process": {
        "argv": [
          "git",
          "{status,diff,log,show,blame,ls-files,ls-tree,rev-parse,describe,shortlog,grep,cat-file,show-ref}",
          "**"
        ]
      }
    },
    {
      "id": "vendor.process.allow-git-listing",
      "effect": "allow",
      "text": "Listing git branches, tags and remotes changes nothing.",
      "process": { "argv": ["git", "{branch,tag,remote}", "**"] }
    },
    {
      "id": "vendor.process.allow-git-local-commit",
      "effect": "allow",
      "text": "Staging and committing locally (git add, git commit without --amend) is recorded in history and can be undone.",
      "process": { "argv": ["git", "{add,commit}", "**"] }
    },
    {
      "id": "vendor.process.allow-version-and-help",
      "effect": "allow",
      "text": "Asking a program for its version or help text changes nothing.",
      "process": { "argv": ["*", "{--version,-v,-V,version,--help,-h,help}"] }
    },
    {
      "id": "vendor.process.allow-rust-checks",
      "effect": "allow",
      "text": "Cargo checks, lints, formatting, tests and builds stay inside the project and its target folder.",
      "process": {
        "argv": ["cargo", "{check,clippy,test,build,fmt,doc,tree,metadata,nextest,bench}", "**"]
      }
    },
    {
      "id": "vendor.process.allow-node-scripts",
      "effect": "allow",
      "text": "Project test, lint, type-check, format-check and build scripts stay inside the project.",
      "process": {
        "argv": [
          "{npm,pnpm,yarn,bun}",
          "{run,exec}",
          "{test,test:*,lint,lint:*,typecheck,check,check:*,build,build:*,format:check,tsc,vitest,jest,eslint}",
          "**"
        ]
      }
    },
    {
      "id": "vendor.process.allow-node-shorthand",
      "effect": "allow",
      "text": "npm, pnpm and yarn shorthands for tests, lint, type checks, builds and dependency listings stay inside the project.",
      "process": {
        "argv": ["{npm,pnpm,yarn,bun}", "{test,t,typecheck,lint,build,ls,list,outdated,why}", "**"]
      }
    },
    {
      "id": "vendor.process.allow-js-tools",
      "effect": "allow",
      "text": "JavaScript type checkers, linters and test runners stay inside the project.",
      "process": { "argv": ["{tsc,eslint,vitest,jest,mocha,biome,oxlint}", "**"] }
    },
    {
      "id": "vendor.process.allow-prettier-check",
      "effect": "allow",
      "text": "prettier --check only reads files.",
      "process": { "argv": ["prettier", "**", "{--check,-c,--list-different,-l}", "**"] }
    },
    {
      "id": "vendor.process.allow-python-checks",
      "effect": "allow",
      "text": "Python tests, type checks and linters stay inside the project.",
      "process": { "argv": ["{pytest,mypy,pyright,ruff,flake8,pylint,tox,nox}", "**"] }
    },
    {
      "id": "vendor.process.allow-python-module-checks",
      "effect": "allow",
      "text": "Running pytest, mypy, unittest or ruff as a Python module stays inside the project.",
      "process": {
        "argv": [
          "{python,python3,py}",
          "-m",
          "{pytest,mypy,unittest,ruff,pyright,compileall}",
          "**"
        ]
      }
    },
    {
      "id": "vendor.process.allow-uv-run-checks",
      "effect": "allow",
      "text": "uv run with a test or lint tool stays inside the project.",
      "process": { "argv": ["uv", "run", "{pytest,mypy,ruff,pyright}", "**"] }
    },
    {
      "id": "vendor.process.allow-go-dotnet-checks",
      "effect": "allow",
      "text": "Go and .NET builds, tests and vet checks stay inside the project.",
      "process": { "argv": ["{go,dotnet}", "{build,test,vet,list,format}", "**"] }
    },
    {
      "id": "vendor.process.allow-read-only-utilities",
      "effect": "allow",
      "text": "Read-only listing and search utilities (dir, ls, tree, where, which, rg, grep, findstr, cat, type, head, tail, wc) change nothing.",
      "process": {
        "argv": [
          "{dir,ls,tree,where,which,rg,grep,findstr,cat,type,head,tail,wc,pwd,whoami,hostname}",
          "**"
        ]
      }
    }
  ]
}
